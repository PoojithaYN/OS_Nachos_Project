@@ -75,6 +78,19 @@ int PCB::Exec(char* filename, int id) {
     // Trả về id.
     return id;
 }
+int PCB::Exec(char* filename, int id, int pDes) {
+    multex->P();
+    this->thread = new Thread(filename, pDes, true); // Use overloaded thread
+    if (this->thread == NULL) {
+        multex->V();
+        return -1;
+    }
+    this->thread->processID = id;
+    this->parentID = kernel->currentThread->processID;
+    this->thread->Fork(StartProcess_2, &this->thread->processID);
+    multex->V();
+    return id;
+}
 
 int PCB::GetID() { return thread->processID; }
 
