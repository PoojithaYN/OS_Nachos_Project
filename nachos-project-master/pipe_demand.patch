++    }
++
++    int pDes = kernel->machine->ReadRegister(5);
++    kernel->machine->WriteRegister(2, SysExecP(name,pDes));
++    delete[] name;
++    return move_program_counter();
++}
++
++void handle_SC_GetPD(){
++    int pd = SysGetPD();
